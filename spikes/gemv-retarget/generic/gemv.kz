// gemv.kz — comptime-transform GEMV specialization spike.
//
// Mirrors the UchenML claim: "hand-written inner matmul loop, compiles 4x
// (fp16, fp32, matrices with size matching SIMD width and not), targets
// WASM SIMD, Neon, SSE2/AVX/AVX2/AVX512, no branching in the inner loop,
// UchenLoad* template magic for fp32 load vs fp16 load/promote."
//
// The Koru answer: a [comptime|transform] tor — generics-as-library.
// `gemv.kernel[T:f16;I:1002;J:512](name: "k")` is parsed AT COMPILE TIME by
// the transform below, which emits a specialized kernel + storage per
// instantiation. Four invocations -> four monomorphs in ONE binary:
//
//   {f32,f16} x {I:1024 (no tail), I:1002 (tail on 4/8/16-lane vectors)}
//
// The generated kernels are naive scalar Zig — vectorization is LLVM's,
// per the sibling probe (gemv.k): the same source yields fmul.4s on NEON,
// vmulps ymm on AVX2, f32x4.mul on wasm-simd128.
//
// Templates stamp instantiations; this transform READS the invocation site
// and WRITES the program — that is the "and more".

const std = @import("std");

~[comptime|transform] pub tor gemv.* {
    event_name: string,
    invocation: *const Invocation,
    item: *const std/compiler:Item,
    program: *const std/compiler:Program,
    reporter: *std/compiler:ErrorReporter,
    allocator: std.mem.Allocator,
} -> SiteResult

~proc gemv.*|zig {
    const ast = @import("ast");

    const flow = if (item.* == .flow) &item.flow else {
        return ast.refuse(allocator, reporter, .KORU161, item.event_decl.location, "gemv", "gemv.*: transform fired on a non-flow item", .{});
    };
    const loc = flow.location;
    const module = flow.module;

    const fail = struct {
        fn at(a: std.mem.Allocator, r: anytype, l: anytype, m: []const u8, comptime fmt: []const u8, args: anytype) ast.SiteResult {
            return ast.refuse(a, r, .KORU161, l, m, fmt, args);
        }
    }.at;

    // event_name: "gemv.kernel[T:f16;I:1002;J:512]"
    const lb = std.mem.indexOfScalar(u8, event_name, '[') orelse {
        return fail(allocator, reporter, loc, module, "gemv.*: expected bracket params — gemv.kernel[T:f16;I:1002;J:512](name: \"k\")", .{});
    };
    const rb = std.mem.lastIndexOfScalar(u8, event_name, ']') orelse {
        return fail(allocator, reporter, loc, module, "gemv.*: unclosed bracket params", .{});
    };

    var T: []const u8 = "";
    var I: usize = 0;
    var J: usize = 0;
    var pit = std.mem.splitScalar(u8, event_name[lb + 1 .. rb], ';');
    while (pit.next()) |p| {
        const t = std.mem.trim(u8, p, " ");
        const colon = std.mem.indexOfScalar(u8, t, ':') orelse continue;
        const k = std.mem.trim(u8, t[0..colon], " ");
        const v = std.mem.trim(u8, t[colon + 1 ..], " ");
        if (std.mem.eql(u8, k, "T")) {
            T = v;
        } else if (std.mem.eql(u8, k, "I")) {
            I = std.fmt.parseInt(usize, v, 10) catch 0;
        } else if (std.mem.eql(u8, k, "J")) {
            J = std.fmt.parseInt(usize, v, 10) catch 0;
        }
    }
    const valid_T = std.mem.eql(u8, T, "f16") or std.mem.eql(u8, T, "f32") or std.mem.eql(u8, T, "f64");
    if (!valid_T or I == 0 or J == 0 or J % 4 != 0) {
        return fail(allocator, reporter, loc, module, "gemv.*: params are T in {{f16,f32,f64}}, I>0, J>0 multiple of 4 (got T='{s}' I={d} J={d})", .{ T, I, J });
    }

    var name: []const u8 = "";
    for (invocation.args) |arg| {
        if (std.mem.eql(u8, arg.name, "name")) {
            name = std.mem.trim(u8, arg.value, " \t\"");
        }
    }
    if (name.len == 0) {
        return fail(allocator, reporter, loc, module, "gemv.*: kernel needs (name: \"k\") — it names the generated decls", .{});
    }

    // bit pattern width for the checksum: f16->u16, f32->u32, f64->u64
    const B = if (T[1] == '6') "u64" else std.fmt.allocPrint(allocator, "u{s}", .{T[1..]}) catch unreachable;

    const head = std.fmt.allocPrint(allocator,
        \\// ---- generated by gemv.kernel[T:{s};I:{d};J:{d}] (name: {s}) ----
        \\var {s}_w: [{d}]{s} = undefined;
        \\var {s}_x: [{d}]{s} = undefined;
        \\var {s}_of: [{d}]{s} = undefined;
        \\var {s}_on: [{d}]{s} = undefined;
        \\
        \\pub fn {s}_init() void {{
        \\    var j: usize = 0;
        \\    while (j < {d}) : (j += 1) {{
        \\        {s}_x[j] = @as({s}, @floatFromInt(@as(i64, @intCast(@rem(j * 3, 11))) - 5)) * 0.0625;
        \\        var i: usize = 0;
        \\        while (i < {d}) : (i += 1) {{
        \\            {s}_w[j * {d} + i] = @as({s}, @floatFromInt(@as(i64, @intCast(@rem(j * 7 + i * 13, 17))) - 8)) * 0.03125;
        \\        }}
        \\    }}
        \\}}
        \\
        ,
        .{
            T, I, J, name, // comment header
            name, J * I, T, // var w
            name, J, T, // var x
            name, I, T, // var of
            name, I, T, // var on
            name, // pub fn _init
            J, //   while j < J
            name, T, //   _x[j] = @as(T, ...)
            I, //   while i < I
            name, I, T, //   _w[j * I + i] = @as(T, ...)
        }
    ) catch unreachable;

    const body = std.fmt.allocPrint(allocator,
        \\pub fn {s}_run() void {{
        \\    var jg: usize = 0;
        \\    while (jg < {d} / 4) : (jg += 1) {{
        \\        const j = jg * 4;
        \\        const x0 = {s}_x[j];
        \\        const x1 = {s}_x[j + 1];
        \\        const x2 = {s}_x[j + 2];
        \\        const x3 = {s}_x[j + 3];
        \\        var i: usize = 0;
        \\        while (i < {d}) : (i += 1) {{
        \\            {s}_of[i] = {s}_of[i] + {s}_w[j * {d} + i] * x0 + {s}_w[(j + 1) * {d} + i] * x1 + {s}_w[(j + 2) * {d} + i] * x2 + {s}_w[(j + 3) * {d} + i] * x3;
        \\        }}
        \\    }}
        \\}}
        \\
        \\pub fn {s}_naive() void {{
        \\    var j: usize = 0;
        \\    while (j < {d}) : (j += 1) {{
        \\        const xj = {s}_x[j];
        \\        var i: usize = 0;
        \\        while (i < {d}) : (i += 1) {{
        \\            {s}_on[i] = {s}_on[i] + {s}_w[j * {d} + i] * xj;
        \\        }}
        \\    }}
        \\}}
        \\
        ,
        .{
            name, // pub fn _run
            J, //   while jg < J/4
            name, name, name, name, //   x0..x3
            I, //   while i < I
            name, name, //   _of[i] = _of[i] +
            name, I, name, I, name, I, name, I, //   4 x _w[(j+k)*I + i]
            name, // pub fn _naive
            J, //   while j < J
            name, //   xj
            I, //   while i < I
            name, name, name, I, //   _on[i] = _on[i] + _w[j*I+i]*xj
        }
    ) catch unreachable;

    const report = std.fmt.allocPrint(allocator,
        \\pub fn {s}_report() void {{
        \\    {s}_init();
        \\    {s}_run();
        \\    {s}_naive();
        \\    var bf: i64 = 0;
        \\    var bn: i64 = 0;
        \\    var d: i64 = 0;
        \\    for (0..{d}) |i| {{
        \\        bf += @as(i64, @as({s}, @bitCast({s}_of[i])));
        \\        bn += @as(i64, @as({s}, @bitCast({s}_on[i])));
        \\        d += @intFromBool({s}_of[i] != {s}_on[i]);
        \\    }}
        \\    std.debug.print("{s} [T={s} I={d} J={d}]: fast={{d}} naive={{d}} diff={{d}}\n", .{{ bf, bn, d }});
        \\}}
        ,
        .{
            name, // pub fn _report
            name, name, name, //   _init(); _run(); _naive();
            I, //   for (0..I)
            B, name, //   bf bitcast
            B, name, //   bn bitcast
            name, name, //   diff compare
            name, T, I, J, //   print label
        }
    ) catch unreachable;

    const code = std.mem.concat(allocator, u8, &.{ head, body, report }) catch unreachable;

    return .{ .replacement = ast.Item{ .host_line = ast.HostLine{
        .content = code,
        .location = loc,
        .module = allocator.dupe(u8, module) catch unreachable,
    } } };
}

// ---- four instantiations: {f32,f16} x {no-tail, tail} in ONE binary ----
~gemv.kernel[T:f32;I:1024;J:512](name: "k_f32")
~gemv.kernel[T:f32;I:1002;J:512](name: "k_f32t")
~gemv.kernel[T:f16;I:1024;J:512](name: "k_f16")
~gemv.kernel[T:f16;I:1002;J:512](name: "k_f16t")

~tor go {}

~proc go|zig {
    k_f32_report();
    k_f32t_report();
    k_f16_report();
    k_f16t_report();
}

~go()
