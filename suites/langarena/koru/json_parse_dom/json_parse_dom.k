// json_parse_dom — LangArena Json::ParseDom, run.js scored parameters
// (coords=10000, iterations=100, warmup=20 -> 120 runs; checksum =
// sum over runs of checksumFloat(avg x|y|z), where checksumFloat =
// DJB2 of the {d:.7} text — oracle 3989922952, smoke 2918383076).
//
// The document is generated by the same byte-exact path as
// Json::Generate (see that kernel's header) into the doc grid, then
// parsed by a hand-rolled DOM walker — the reference's semantic shape:
// parse to a generic value tree, fetch "coordinates", walk elements.
// No DOM exists in std/json (schema-directed only), so the tree is a
// node grid: {k kind, ks/kl key span, fc/ns/tl child links, nv f64}.
//
// f64 leaf parse is provably strtod-exact for this corpus: input is
// always {d:.8} of [0,1) or the literal 1 — mantissa < 10^9 < 2^53 and
// 10^k exactly representable, so mantissa/10^k in one IEEE division is
// the correctly-rounded double, which is what std.fmt.parseFloat and
// strtod both return.
//
// Toolchain gap (parked): no .k spelling hands grid bytes to a
// `string` param, so std/json:parse cannot take the generated doc —
// see suites/langarena/PARKED.md.
//
import std/io
import std/grid
import std/store
import std/fmt

std/grid:new(gx, size: 10000) { v: 0.0[f64] }
std/grid:new(gy, size: 10000) { v: 0.0[f64] }
std/grid:new(gz, size: 10000) { v: 0.0[f64] }
std/grid:new(nm, size: 320000) { c: 0[u8] }
std/grid:new(nl, size: 10000) { n: 0[i64] }
std/grid:new(doc, size: 960000) { b: 0[u8] }
std/grid:new(nd, size: 100000) { k: 0[u8], ks: 0[i64], kl: 0[i64], fc: 0[i64], ns: 0[i64], tl: 0[i64], nv: 0.0[f64] }
std/store:new(st) { last: 42[i64], acc: 0[i64], p: 0[i64], pos: 0[i64], nn: 0[i64], num: 0[i64], frc: 0[i64], t1: 0[i64], t2: 0[i64], t3: 0[i64], k1: 0[i64], k2: 0[i64], nc: 0[i64] }
std/store:new(fs) { sx: 0.0[f64], sy: 0.0[f64], sz: 0.0[f64] }

// nxt — one Helper.next_int draw
pub tor nxt { max: f64 } -> i64
nxt = std/store:stored { st.last: @rem(st.last *% 3877 +% 29573, 139968) }: _ -> @as(i64, @intFromFloat(@as(f64, @floatFromInt(st.last)) / 139968.0 * max))

// nxfl — one Helper.nextFloat(1.0) draw (last/IM under both orders)
pub tor nxfl { } -> f64
nxfl = std/store:stored { st.last: @rem(st.last *% 3877 +% 29573, 139968) }: _ -> @as(f64, @floatFromInt(st.last)) / 139968.0

pub tor ret0 { } -> i64
ret0 = if(0 == 0)
| then -> 0
| else -> 0

// ---- document generation (identical to json_generate) ----

pub tor fhead { } -> i64
fhead = for("{\"coordinates\":[")
    ! each ch |> std/grid:stored { doc[st.p].b: ch }
        |> std/store:stored { st.p: st.p + 1 }
    | done
    |> ret0(): r -> r

pub tor fcomma { } -> i64
fcomma = for(",")
    ! each ch |> std/grid:stored { doc[st.p].b: ch }
        |> std/store:stored { st.p: st.p + 1 }
    | done
    |> ret0(): r -> r

pub tor fx { } -> i64
fx = for("{\"x\":")
    ! each ch |> std/grid:stored { doc[st.p].b: ch }
        |> std/store:stored { st.p: st.p + 1 }
    | done
    |> ret0(): r -> r

pub tor fy { } -> i64
fy = for(",\"y\":")
    ! each ch |> std/grid:stored { doc[st.p].b: ch }
        |> std/store:stored { st.p: st.p + 1 }
    | done
    |> ret0(): r -> r

pub tor fz { } -> i64
fz = for(",\"z\":")
    ! each ch |> std/grid:stored { doc[st.p].b: ch }
        |> std/store:stored { st.p: st.p + 1 }
    | done
    |> ret0(): r -> r

pub tor fnm { } -> i64
fnm = for(",\"name\":\"")
    ! each ch |> std/grid:stored { doc[st.p].b: ch }
        |> std/store:stored { st.p: st.p + 1 }
    | done
    |> ret0(): r -> r

pub tor ftail { } -> i64
ftail = for("\",\"opts\":{\"1\":[1,true]}}")
    ! each ch |> std/grid:stored { doc[st.p].b: ch }
        |> std/store:stored { st.p: st.p + 1 }
    | done
    |> ret0(): r -> r

pub tor fend { } -> i64
fend = for("],\"info\":\"some info\"}")
    ! each ch |> std/grid:stored { doc[st.p].b: ch }
        |> std/store:stored { st.p: st.p + 1 }
    | done
    |> ret0(): r -> r

pub tor cpy { t: string<*@scoped> } -> i64
cpy = for(0..t.len)
    ! each k |> std/grid:stored { doc[st.p].b: t[k] }
        |> std/store:stored { st.p: st.p + 1 }
    | done
    |> ret0(): _ -> 0

pub tor ncpy { t: string<*@scoped>, i: i64 } -> i64
ncpy = for(0..t.len)
    ! each k |> std/grid:stored { nm[i * 32 + @as(i64, @intCast(k))].c: t[k] }
    | done
    |> std/grid:stored { nl[i].n: @as(i64, @intCast(t.len)) }: _ -> 0

pub tor putf { v: f64 } -> i64
putf = std/fmt:ln("{{ v:d:.8 }}"): s
    |> cpy(t: s.text): _ -> 0

pub tor pname { i: i64 } -> i64
pname = for(0..@as(usize, @intCast(nl[i].n)))
    ! each k |> std/grid:stored { doc[st.p].b: nm[i * 32 + @as(i64, @intCast(k))].c }
        |> std/store:stored { st.p: st.p + 1 }
    | done
    |> ret0(): r -> r

pub tor emite { i: i64 } -> i64
emite = if(i > 0)
| then |> fcomma(): _
| else |> ret0(): _
|> fx(): _
|> putf(v: gx[i].v): _
|> fy(): _
|> putf(v: gy[i].v): _
|> fz(): _
|> putf(v: gz[i].v): _
|> fnm(): _
|> pname(i): _
|> ftail(): _ -> 0

// ---- DOM parser over doc[0..st.p] ----

// mkn — allocate a node of kind k, return its id
pub tor mkn { k: i64 } -> i64
mkn = std/grid:stored { nd[st.nn].k: @as(u8, @intCast(k)) }
    |> std/grid:stored { nd[st.nn].ks: 0 }
    |> std/grid:stored { nd[st.nn].kl: 0 }
    |> std/grid:stored { nd[st.nn].fc: -1 }
    |> std/grid:stored { nd[st.nn].ns: -1 }
    |> std/grid:stored { nd[st.nn].tl: -1 }
    |> std/grid:stored { nd[st.nn].nv: 0.0 }
    |> std/store:stored { st.nn: st.nn + 1 }
    |> ret0(): _ -> (st.nn - 1)

// link — append child c under parent par (fc/ns/tl chain)
pub tor link { par: i64, c: i64 } -> i64
link = if(nd[par].tl == -1)
| then |> std/grid:stored { nd[par].fc: c }
| else |> std/grid:stored { nd[nd[par].tl].ns: c }
|> std/grid:stored { nd[par].tl: c }: _ -> 0

// pdig — digit loop: accumulate doc[st.pos] into st.num; frac counts
// digits after the point into st.frc. Self-tail loop.
pub tor pdig { frac: i64 } -> i64
pdig = if(doc[st.pos].b >= 48 and doc[st.pos].b <= 57)
| then |> std/store:stored { st.num: st.num * 10 + doc[st.pos].b - 48 }
    |> std/store:stored { st.pos: st.pos + 1 }
    |> if(frac == 1)
        | then |> std/store:stored { st.frc: st.frc + 1 }
            |> pdig(frac): r -> r
        | else |> pdig(frac): r -> r
| else -> 0

// pow10 — 10^e as f64
pub tor pow10 { e: i64, v: f64 } -> f64
pow10 = if(e > 0)
| then |> pow10(e: e - 1, v: v * 10.0): r -> r
| else -> v

// pnum — parse a JSON number: int digits, optional .frac digits.
// m / 10^f in one IEEE division is strtod-exact here (see header).
pub tor pnum { } -> f64
pnum = std/store:stored { st.num: 0 }
    |> std/store:stored { st.frc: 0 }
    |> pdig(frac: 0): _
    |> if(doc[st.pos].b == 46)
        | then |> std/store:stored { st.pos: st.pos + 1 }
            |> pdig(frac: 1): _
        | else |> ret0(): _
        |> pow10(e: st.frc, v: 1.0): d
        |> ret0(): _ -> @as(f64, @floatFromInt(st.num)) / d

// pscan — advance pos to the closing quote (no escapes in this doc)
pub tor pscan { } -> i64
pscan = if(doc[st.pos].b == 34)
| then -> 0
| else |> std/store:stored { st.pos: st.pos + 1 }
    |> pscan(): r -> r

// pstr — consume "...", span lands in st.t1 (start)/st.t2 (len)
pub tor pstr { } -> i64
pstr = std/store:stored { st.pos: st.pos + 1 }
    |> std/store:stored { st.t1: st.pos }
    |> pscan(): _
    |> std/store:stored { st.t2: st.pos - st.t1 }
    |> std/store:stored { st.pos: st.pos + 1 }: _ -> 0

// pnode — parse one JSON value, return node id. Dispatch split across
// pnode2/3/4 — an `if` is terminal inside its own chain, so the arm
// bodies delegate to the next dispatch tor.
pub tor pnode { } -> i64
pnode = if(doc[st.pos].b == 123)
| then |> pobj(): r -> r
| else |> pnode2(): r -> r

pub tor pnode2 { } -> i64
pnode2 = if(doc[st.pos].b == 91)
| then |> parr(): r -> r
| else |> pnode3(): r -> r

pub tor pnode3 { } -> i64
pnode3 = if(doc[st.pos].b == 34)
| then |> pstr(): _
    |> mkn(k: 4): nd0
    |> std/grid:stored { nd[nd0].ks: st.t1 }
    |> std/grid:stored { nd[nd0].kl: st.t2 }: _ -> nd0
| else |> pnode4(): r -> r

pub tor pnode4 { } -> i64
pnode4 = if(doc[st.pos].b == 110)
| then |> std/store:stored { st.pos: st.pos + 4 }
    |> mkn(k: 6): r -> r
| else |> pnode5(): r -> r

pub tor pnode5 { } -> i64
pnode5 = if(doc[st.pos].b == 116 or doc[st.pos].b == 102)
| then |> if(doc[st.pos].b == 116)
    | then |> std/store:stored { st.pos: st.pos + 4 }
    | else |> std/store:stored { st.pos: st.pos + 5 }
    |> mkn(k: 5): r -> r
| else |> pnum(): v
    |> mkn(k: 3): nd0
    |> std/grid:stored { nd[nd0].nv: v }: _ -> nd0

// pobj — consume '{', loop fields via pfields
pub tor pobj { } -> i64
pobj = std/store:stored { st.pos: st.pos + 1 }
    |> mkn(k: 1): nd0
    |> pfields(o: nd0): _ -> nd0

// pfields — object field loop: "key" : value then , or }
pub tor pfields { o: i64 } -> i64
pfields = if(doc[st.pos].b == 125)
| then |> std/store:stored { st.pos: st.pos + 1 }: _ -> 0
| else |> pstr(): _
    |> std/store:stored { st.pos: st.pos + 1 }
    |> pfield(o, k1: st.t1, k2: st.t2): r -> r

// pfield — parse one value under key span (k1,k2), link, loop on ","
// (span rides params — nested pnode recursion clobbers store scratch)
pub tor pfield { o: i64, k1: i64, k2: i64 } -> i64
pfield = pnode(): ch
    |> std/grid:stored { nd[ch].ks: k1 }
    |> std/grid:stored { nd[ch].kl: k2 }
    |> link(par: o, c: ch): _
    |> if(doc[st.pos].b == 44)
        | then |> std/store:stored { st.pos: st.pos + 1 }
            |> pfields(o): r -> r
        | else |> std/store:stored { st.pos: st.pos + 1 }: _ -> 0

// parr — consume '[', loop elements via pelems
pub tor parr { } -> i64
parr = std/store:stored { st.pos: st.pos + 1 }
    |> mkn(k: 2): nd0
    |> pelems(a: nd0): _ -> nd0

// pelems — array element loop
pub tor pelems { a: i64 } -> i64
pelems = if(doc[st.pos].b == 93)
| then |> std/store:stored { st.pos: st.pos + 1 }: _ -> 0
| else |> pnode(): ch
    |> link(par: a, c: ch): _
    |> if(doc[st.pos].b == 44)
        | then |> std/store:stored { st.pos: st.pos + 1 }
            |> pelems(a): r -> r
        | else |> std/store:stored { st.pos: st.pos + 1 }: _ -> 0

// ---- DOM walk: root -> "coordinates" -> per-element x/y/z sums ----

// wone — fold node ch's value into the right sum (keys are 1-char
// x/y/z here; first byte dispatches)
pub tor wone { ch: i64 } -> i64
wone = if(nd[ch].kl == 1 and doc[nd[ch].ks].b == 120)
| then |> std/store:stored { fs.sx: fs.sx + nd[ch].nv }: _ -> 0
| else |> wone2(ch): r -> r

pub tor wone2 { ch: i64 } -> i64
wone2 = if(nd[ch].kl == 1 and doc[nd[ch].ks].b == 121)
| then |> std/store:stored { fs.sy: fs.sy + nd[ch].nv }: _ -> 0
| else |> wone3(ch): r -> r

pub tor wone3 { ch: i64 } -> i64
wone3 = if(nd[ch].kl == 1 and doc[nd[ch].ks].b == 122)
| then |> std/store:stored { fs.sz: fs.sz + nd[ch].nv }: _ -> 0
| else -> 0

// wsum — walk a coord object's children
pub tor wsum { ch: i64 } -> i64
wsum = if(ch == -1)
| then -> 0
| else |> wone(ch): _
    |> wsum(ch: nd[ch].ns): r -> r

// warr — walk the coordinates array's element objects
pub tor warr { el: i64 } -> i64
warr = if(el == -1)
| then -> 0
| else |> wsum(ch: nd[el].fc): _
    |> std/store:stored { st.nc: st.nc + 1 }
    |> warr(el: nd[el].ns): r -> r

// wroot — find the "coordinates" field among the root's children
pub tor wroot { ch: i64 } -> i64
wroot = if(ch == -1)
| then -> 0
| else |> if(nd[ch].kl == 11 and doc[nd[ch].ks].b == 99)
    | then |> warr(el: nd[ch].fc): r -> r
    | else |> wroot(ch: nd[ch].ns): r -> r

// djh — DJB2 a scoped string into st.t3
pub tor djh { t: string<*@scoped> } -> i64
djh = for(0..t.len)
    ! each k |> std/store:stored { st.t3: @rem(st.t3 * 33 + @as(i64, @intCast(t[k])), 4294967296) }
    | done
    |> ret0(): _ -> 0

// csum — checksumFloat(v): DJB2 of the {d:.7} text, into acc mod 2^32
pub tor csum { v: f64 } -> i64
csum = std/fmt:ln("{{ v:d:.7 }}"): s
    |> std/store:stored { st.t3: 5381 }
    |> djh(t: s.text): _
    |> std/store:stored { st.acc: @rem(st.acc + st.t3, 4294967296) }: _ -> 0

// ---- driver ----

// generate the document (prepare): 10000 entries
for(0..10000)
! each i |> nxfl(): a
    |> nxfl(): b
    |> nxfl(): c
    |> std/grid:stored { gx[i].v: a }
    |> std/grid:stored { gy[i].v: b }
    |> std/grid:stored { gz[i].v: c }
    |> nxfl(): nf
    |> nxt(max: 10000.0): ni
    |> std/fmt:ln("{{ nf:d:.7 }} {{ ni:d }}"): s
    |> ncpy(t: s.text, i: @as(i64, @intCast(i))): _

std/store:stored { st.p: 0 }
|> fhead(): _
|> for(0..10000)
    ! each i |> emite(i: @as(i64, @intCast(i))): _
    | done
|> fend(): _

// runs: 120 = 100 measured + 20 warmup. Each run re-parses the whole
// document into a fresh DOM and averages the coordinate floats.
for(0..120)
! each _ |> std/store:stored { st.pos: 0 }
    |> std/store:stored { st.nn: 0 }
    |> std/store:stored { fs.sx: 0.0 }
    |> std/store:stored { fs.sy: 0.0 }
    |> std/store:stored { fs.sz: 0.0 }
    |> std/store:stored { st.nc: 0 }
    |> pnode(): root
    |> wroot(ch: nd[root].fc): _
    |> csum(v: fs.sx / @as(f64, @floatFromInt(st.nc))): _
    |> csum(v: fs.sy / @as(f64, @floatFromInt(st.nc))): _
    |> csum(v: fs.sz / @as(f64, @floatFromInt(st.nc))): _

std/io:print.ln("{{ st.acc:d }}")
